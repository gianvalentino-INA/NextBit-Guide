# NextBit Backend — copy this file to Backend/.env and fill in values.
# NEVER commit Backend/.env. Keep all keys secret.

# Server
PORT=1140

# AI Chat (OpenRouter)
AI_API_KEY=
SITE_URL=http://localhost:1140

# Backblaze B2 (private bucket)
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-east-1
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_TEST_TOKEN=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
TEST_EMAIL=

# Midtrans — use SANDBOX credentials for local development only.
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false